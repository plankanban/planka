# =============================================================================
# Production environment variables
# =============================================================================
# Copy this file to `.env` and fill all values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
# These domains MUST already point to the server's public IP via DNS A records.
# Caddy will automatically provision Let's Encrypt TLS certs on first request.
PLANKA_DOMAIN=app.seudominio.com.br
FORM_DOMAIN=formularios.seudominio.com.br
LETSENCRYPT_EMAIL=admin@seudominio.com.br

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=GERAR_SENHA_FORTE_AQUI

# -----------------------------------------------------------------------------
# Planka
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 64
SECRET_KEY=GERAR_HEX_64_BYTES_AQUI

ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=GERAR_SENHA_FORTE_AQUI
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin

# -----------------------------------------------------------------------------
# Ticket Form Service
# -----------------------------------------------------------------------------
# Use the same Planka admin credentials (or create a dedicated bot user
# with editor access on both boards and put those credentials here).
PLANKA_FORM_EMAIL=admin@seudominio.com.br
PLANKA_FORM_PASSWORD=GERAR_SENHA_FORTE_AQUI

# -----------------------------------------------------------------------------
# Board lookup — IDs are NO LONGER REQUIRED.
# -----------------------------------------------------------------------------
# The `02_default_boards` seed creates "Design" and "Chamados Técnicos" boards
# (with default lists and priority labels) on first run. The ticket-form then
# resolves the IDs by NAME via the Planka API and caches them in memory.
#
# You only need the variables below if you renamed something or want to force
# a specific target. Otherwise leave them blank — defaults will be used.

# Names used to look the targets up (defaults match the seed):
# PLANKA_PROJECT_NAME=PDView ERP
# PLANKA_DESIGN_BOARD_NAME=Design
# PLANKA_DESIGN_LIST_NAME=Demanda
# PLANKA_CHAMADOS_BOARD_NAME=Chamados Técnicos
# PLANKA_CHAMADOS_LIST_NAME=Em Espera

# Optional explicit IDs — when set, take precedence over name-based lookup.
PLANKA_LIST_ID=
PLANKA_CHAMADOS_LIST_ID=

# Optional priority label ID overrides. Format: "NAME:id,NAME:id,..."
# Leave empty to auto-discover from the Chamados Técnicos board.
PRIORITY_LABELS=

# Reasons shown in the simple `/api/submit` form (legacy — kept for compatibility)
CONTACT_REASONS=Manutenção,Financeiro,Troca de Arte

# -----------------------------------------------------------------------------
# Supabase mirror
# -----------------------------------------------------------------------------
# When set, both the Planka backend and the ticket-form will write a mirror
# copy of every card and form submission into Supabase (tables: cards,
# card_events, form_submissions — see supabase/migrations/001_initial_schema.sql).
# Postgres remains the primary store; Supabase is read-only for n8n/Streamlit.
#
# To enable, fill BOTH variables. To disable, leave them empty (no-op).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Auto-archive of completed cards
# -----------------------------------------------------------------------------
# Cards sitting in any list of type "closed" (Concluído) for longer than this
# threshold are automatically moved to the board's Archive list.
# Set to 0 to disable the sweep entirely.
AUTO_ARCHIVE_CLOSED_AFTER_DAYS=30
# How often (in minutes) the sweep runs. Default 60.
AUTO_ARCHIVE_CHECK_INTERVAL_MIN=60
